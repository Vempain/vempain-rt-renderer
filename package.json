{
  "name": "@vempain/vempain-rt-renderer",
  "version": "0.1.0",
  "description": "Vempain rich text page/embed renderer component library",
  "author": "Paul-Erik Törrönen",
  "license": "GPL-2.0",
  "type": "module",
  "packageManager" : "yarn@4.18.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node generateBuildInfo.js",
    "build": "tsc -p tsconfig.build.json",
    "build:production": "yarn prebuild && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "@ant-design/charts": "^2.6.5",
    "antd": "^6.4.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@ant-design/charts": "^2.6.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native" : "npm:typescript@^6.0.3",
    "antd": "^6.6.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.18.4",
    "ts-jest" : "^29.4.14",
    "typescript" : "^7.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vempain/vempain-rt-renderer.git"
